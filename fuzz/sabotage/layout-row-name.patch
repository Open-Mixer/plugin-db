     const phd_layout_clap_param_t *x = *(const phd_layout_clap_param_t *const *)a;
     const phd_layout_clap_param_t *y = *(const phd_layout_clap_param_t *const *)b;
 
-    return x->id != y->id ? (x->id < y->id ? -1 : 1) : (x < y ? -1 : x > y);
