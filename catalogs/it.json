{
  "$schema": "../schema/omx-contract.schema.json#/$defs/catalog",
  "kind": "catalog",
  "lang": "it",
  "owner": "plugin-db",
  "messages": {
    "PLUGIN_DB_BAR.load-all": { "text": "Offri ogni plugin, inclusi quelli rifiutati.‎", "by": "machine", "model": "draft-prose", "source": "045a6d4d9ad257ad11208e8aafd16a810b70129863431371b8b0113868666b55" },
    "PLUGIN_DB_BAR.qualified-only": { "text": "Offri solo plugin qualificati.‎", "by": "machine", "model": "draft-prose", "source": "ee1f3856c290de6bd693171b977a6ffd634d5e7d60336f44822698bb6977b0e2" },
    "PLUGIN_DB_BAR.warn-on-crashes": { "text": "Offri ogni plugin che non viene rifiutato; chiedi solo dopo un crash.‎", "by": "machine", "model": "draft-prose", "source": "cf4e94d822bc3ab90719c67d19ce0f2f498c21ac4b6147ab5631312a0d3e0cea" },
    "PLUGIN_DB_LATENCY.over": { "text": "Latenza oltre il limite; si carica comunque.‎", "by": "machine", "model": "draft-prose", "source": "ee8863ad8b334ddd161e720bf1492d4306eae49c9abb990ce0ecdf7c30d3fcb9" },
    "PLUGIN_DB_LATENCY.unmeasured": { "text": "Latenza non misurata.‎", "by": "machine", "model": "draft-prose", "source": "aeb01a8873ff60f9478ecce36394807507772c241263a0d57676bdaadcd85fa6" },
    "PLUGIN_DB_LATENCY.within": { "text": "Latenza entro il limite.‎", "by": "machine", "model": "draft-prose", "source": "16a6162cbd39d488e32e652d754642266fe4cc758baaef4e555378f8f253d31a" },
    "PLUGIN_DB_REASONS.condition-fails": { "text": "Una condizione del suo record non è valida su questa macchina.", "by": "machine", "model": "draft-prose", "source": "8356b543050436c0718904b04335594753f203291249d2fc2df9e1953cd16e75" },
    "PLUGIN_DB_REASONS.could-not-test": { "text": "I suoi file non potevano essere letti.", "by": "machine", "model": "draft-prose", "source": "2629ef8f2cc635a71374f9b58d8f34aad60fc915ea7af7743a057a9307bbed49" },
    "PLUGIN_DB_REASONS.files-changed": { "text": "I suoi file sono cambiati dopo essere stati scansionati.", "by": "machine", "model": "draft-prose", "source": "07de2023a91a18f33a56ad58417c5a95a9d42becb387f95faa98de41b35b0d52" },
    "PLUGIN_DB_REASONS.files-gone": { "text": "I suoi file sono spariti.", "by": "machine", "model": "draft-prose", "source": "1166e54be62eef932567870515d631de2950e43400348d53593f94fc57c7b083" },
    "PLUGIN_DB_REASONS.layout-changed": { "text": "I suoi parametri sono cambiati dopo essere stati scansionati.", "by": "machine", "model": "draft-prose", "source": "f89e8b7bc910e0c599e761cbf4c43b03042164cd48e9d53c314b51c6205c22ca" },
    "PLUGIN_DB_REASONS.layout-not-yet-known": { "text": "I suoi parametri non sono ancora noti.", "by": "machine", "model": "draft-prose", "source": "d09489e7312971cfb34cf278942df53e98f032480d772ae9c11ff438fe318301" },
    "PLUGIN_DB_REASONS.measurement-pending": { "text": "Non è ancora stato misurato.", "by": "machine", "model": "draft-prose", "source": "09c3407367d440e0d8eaed403e6139e1aa884d48619d3d7baeea0381271b9445" },
    "PLUGIN_DB_REASONS.never-pinned": { "text": "Non è mai stato scansionato.", "by": "machine", "model": "draft-prose", "source": "912de7cd3acfcc02f3f4e448d73a90f812ec10d9eb0ffed72cfd297aa6d1a5c8" },
    "PLUGIN_DB_REASONS.no-cell": { "text": "Il suo record non ha misurazioni a questo rate e quantum.", "by": "machine", "model": "draft-prose", "source": "6a16198594f927a9d0917287303aac92ed50632d6c9345ef2afd02ca02cbe61a" },
    "PLUGIN_DB_REASONS.not-measured-under-host": { "text": "Il suo record dice solo, ma non è stato misurato sotto plugin-hostd.", "by": "machine", "model": "draft-prose", "source": "99a49dccf020b227acbc73734629c3eb51f442d7c25d6973a9324b0db328a087" },
    "PLUGIN_DB_REASONS.record-refused": { "text": "Il suo record dice rifiutato.", "by": "machine", "model": "draft-prose", "source": "86d4f2832c1e802298192fc20ec12e8b374a7a0be7a56fab723c1b4f6aefdbbe" },
    "PLUGIN_DB_REASONS.record-stale": { "text": "Il suo record non è più valido e deve essere misurato di nuovo.", "by": "machine", "model": "draft-prose", "source": "599a36e557eb0997bdb461fb46e41fd1827ad68fa6c620951648c37c352cb33f" },
    "PLUGIN_DB_REASONS.reference-only": { "text": "Misurato su un altro tipo di macchina: solo dati di riferimento.", "by": "machine", "model": "draft-prose", "source": "c9dbf0d555c7c4e136fdd50a8cd33b9cdbd7bcec5c8f665dcdf91643e1881021" },
    "PLUGIN_DB_REASONS.shipped-refusal": { "text": "Questi file sono rifiutati dal record fornito con essi.", "by": "machine", "model": "draft-prose", "source": "4fd02eca86616630f7cafb516f50ecca04ea475639d736aec9caff1f7b509b82" },
    "PLUGIN_DB_REASONS.verdict-allows": { "text": "Il suo record consente un worker condiviso.", "by": "machine", "model": "draft-prose", "source": "8bfa84177d7bf2da179eef7c810607fb23919e1ea79561984dc29e58f49071ef" },
    "PLUGIN_DB_REASONS.verdict-isolated": { "text": "Il suo record dice che è sicuro solo da solo.", "by": "machine", "model": "draft-prose", "source": "b454c49c2921a2ef6845cacb3bd7a14cf627a6eac6619e2781aaff970cf66f14" },
    "PLUGIN_DB_RECORD.current": { "text": "Il suo record è attuale.", "by": "machine", "model": "draft-prose", "source": "49f389dabaa607181cc4795bc887b58013f8baf5d22e583ccb7c1f358a124227" },
    "PLUGIN_DB_RECORD.none": { "text": "Non ha record.", "by": "machine", "model": "draft-prose", "source": "317abed63e85e5d517254700bfafab872d8f237f2f540db74fe806a4daececa0" },
    "PLUGIN_DB_RECORD.stale": { "text": "Il suo record non è più valido.", "by": "machine", "model": "draft-prose", "source": "0fb9eb3a94e9de3b64bce4aa5afa5903afdfd13de8b42e57f4b2cdbe9eee030d" },
    "PLUGIN_DB_RECORD_ACTIONS.convert": { "text": "Converti il record; non viene più misurato.", "by": "machine", "model": "draft-prose", "source": "2894122d897213172d6cf76736460e1f3aac7c192ecbc67365b89c0390e319ac" },
    "PLUGIN_DB_RECORD_ACTIONS.full-path": { "text": "Scansiona, misura e giudica di nuovo.", "by": "machine", "model": "draft-prose", "source": "1a583cf579dea890f11584fbc6f7b9f6efdc9596bf8d5c82f4090d3b208f736e" },
    "PLUGIN_DB_RECORD_ACTIONS.measure-here": { "text": "Misuralo su questa macchina.", "by": "machine", "model": "draft-prose", "source": "44658df8cb57a0a5f2c5c9310ff3adcebc766ccebb81070db0f4af7aacf2c7f8" },
    "PLUGIN_DB_RECORD_ACTIONS.rejudge": { "text": "Giudica di nuovo le misurazioni; non vengono più misurate.", "by": "machine", "model": "draft-prose", "source": "18ce4a98677932611798c20037c95c74457a83accc574169c2626b6d51566ec6" },
    "PLUGIN_DB_RECORD_ACTIONS.remeasure-background": { "text": "Il record è ancora valido; viene misurato di nuovo in background.", "by": "machine", "model": "draft-prose", "source": "977c994332843341095660c61d59687121d1033968ebe8e856b49024b8f57e7a" },
    "PLUGIN_DB_RECORD_CHANGES.files": { "text": "I suoi file sono cambiati.", "by": "machine", "model": "draft-prose", "source": "b87e0dfb7500e637e16292b44dad72e3eb1f907016c9a8f90d528322ea95340f" },
    "PLUGIN_DB_RECORD_CHANGES.host-version": { "text": "L'host è un'altra versione.", "by": "machine", "model": "draft-prose", "source": "26d3cbd08dbf96a47587fec9e51ee5849d3e323ca3eedfc9e74908910f5b4a58" },
    "PLUGIN_DB_RECORD_CHANGES.hosting-change": { "text": "L'host ha cambiato il modo in cui ospita i plugin.", "by": "machine", "model": "draft-prose", "source": "3ef88d6ae11fa614fd550827ed1ba9c64a4a2a15b0e640167a6ace76f69957f3" },
    "PLUGIN_DB_RECORD_CHANGES.layout": { "text": "I suoi parametri sono cambiati.", "by": "machine", "model": "draft-prose", "source": "63ab28c56d071aaec69afe31bf874c2d3782caa573bf48a1d9ecf8eead73594c" },
    "PLUGIN_DB_RECORD_CHANGES.machine-class": { "text": "Questa è un'altra macchina.", "by": "machine", "model": "draft-prose", "source": "b9a2b6305678714cf54efae9e9aafee2aba8cfcf39247d70190889a62ac2da8d" },
    "PLUGIN_DB_RECORD_CHANGES.rules": { "text": "Le regole di qualifica sono cambiate.", "by": "machine", "model": "draft-prose", "source": "63afd5d00424fad5437109d527ef319c9a53591d7feef52e50082debe7f37249" },
    "PLUGIN_DB_RECORD_CHANGES.schema": { "text": "Il formato del record è cambiato.", "by": "machine", "model": "draft-prose", "source": "80922952e956cf186f9d00797ca9c5c05eb2efd0e2e0e851ab8bd67744091c68" },
    "PLUGIN_DB_RUNS.alone": { "text": "Esegue da solo, in un worker dedicato.", "by": "machine", "model": "draft-prose", "source": "94d655a971db6331fa4aedf150bc3e8e1ce7fcf33e7d2e3914ddbc9830bb41df" },
    "PLUGIN_DB_RUNS.not-loaded": { "text": "Non caricato: un effetto fa passare l'audio, uno strumento è silenzioso.", "by": "machine", "model": "draft-prose", "source": "dbe7d1d7cc05f2fe79882209c121cecd24700534572516d389ec50b19fd30649" },
    "PLUGIN_DB_RUNS.shared": { "text": "Esegue in un worker condiviso.", "by": "machine", "model": "draft-prose", "source": "15d51673dfacef9c8f9e8ecfd6d591586709be6f4b34ae33001a1ba82cb1ac9b" },
    "PLUGIN_DB_SOURCES.local": { "text": "Misurato su questa macchina.‎", "by": "machine", "model": "draft-prose", "source": "1b10e74a78b1e6dccfcb4ba606d86ee4a3d92d7b507ce6fdcb467b369e0ad836" },
    "PLUGIN_DB_SOURCES.none": { "text": "Nessun dato.‎", "by": "machine", "model": "draft-prose", "source": "05877f31e955381afb6de168c00b0ed9ae0c2fd9c40b0a68ef547c8365c38dc9" },
    "PLUGIN_DB_SOURCES.reference": { "text": "Misurato su una macchina di riferimento.‎", "by": "machine", "model": "draft-prose", "source": "1f03dac70ea4a557c19d8b74a0966426e374b9e76c3e0e68be190de2a8d9e5ce" },
    "PLUGIN_DB_STATES.absent": { "text": "I suoi file sono spariti: non è caricato.", "by": "machine", "model": "draft-prose", "source": "3ca4115ddd5aad63a569a4c2d2fe426a59de2c1f80d610983f0dca87738980f3" },
    "PLUGIN_DB_STATES.conditions-unmet": { "text": "Il suo record non copre le impostazioni di questa macchina: funziona da solo.", "by": "machine", "model": "draft-prose", "source": "3b532a25ab0ff6fa68e405a5e05673d8a425dac4d955ccce9cdb7881903c1a55" },
    "PLUGIN_DB_STATES.isolated-only": { "text": "Qualificato per funzionare solo da solo.", "by": "machine", "model": "draft-prose", "source": "ce7391d9dbed56b72307721405ce105a60faf7e4ec78b057ba31319d3db6a6f2" },
    "PLUGIN_DB_STATES.qualified": { "text": "Qualificato: funziona come consentito dal suo record.", "by": "machine", "model": "draft-prose", "source": "0e5d6f8083f26a83a0f1f74d3d9f9583bde74b9f7be1015434695ef54e7d6ad7" },
    "PLUGIN_DB_STATES.refused": { "text": "Rifiutato: non è caricato.", "by": "machine", "model": "draft-prose", "source": "b2de42f5334c90c22bd381871e25f0cca2c69238253396dd039a002ed25c5e93" },
    "PLUGIN_DB_STATES.unqualified": { "text": "Non qualificato: funziona da solo, in un worker dedicato.", "by": "machine", "model": "draft-prose", "source": "3c824bea2898e69028789fe2fb40b2c80c4e1bd1a886eb318a68458b6db1d7a8" }
  }
}
