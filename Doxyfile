# The C API reference of libplugin-db, over the installed headers. The documentation gate is Open-Mixer/.github's
# doc-gate (ci.yml): every warning doxygen writes is a row of docs/doxygen-baseline.txt, which only shrinks, under the
# doxygen docs/doxygen-version.txt pins. `make docs-site` renders the same Doxyfile for the published reference.
PROJECT_NAME           = libplugin-db
PROJECT_BRIEF          = "The plugin database: the store, its reader and its vocabulary"
OUTPUT_DIRECTORY       = build/doxygen
INPUT                  = include/plugin-db
# rendered from the domain plugin-db and data/ (omx-contract render, tools/render-db.py) and documented there
EXCLUDE                = include/plugin-db/plugin_db_codes.h include/plugin-db/plugin_db_tables.h
FILE_PATTERNS          = *.h
RECURSIVE              = NO
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
WARN_FORMAT            = "$file:$line: $text"
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
SEARCHENGINE           = NO
HAVE_DOT               = NO
